_format_version: "2.1"
_transform: true

consumers:
  - username: anon
    keyauth_credentials:
      - key: ${ANON_KEY}
  - username: service_role
    keyauth_credentials:
      - key: ${SERVICE_ROLE_KEY}

plugins:
  - name: cors

services:
  - name: auth-v1
    url: ${AUTH_URL}/
    routes:
      - name: auth-v1
        strip_path: true
        paths: [/auth/v1/]

  - name: rest-v1
    url: ${REST_URL}/
    routes:
      - name: rest-v1
        strip_path: true
        paths: [/rest/v1/]

  - name: storage-v1
    url: ${STORAGE_URL}/
    routes:
      - name: storage-v1
        strip_path: true
        paths: [/storage/v1/]

  - name: functions-v1
    url: ${FUNCTIONS_URL}/
    read_timeout: 300000
    routes:
      - name: functions-v1
        strip_path: true
        paths: [/functions/v1/]
