# ===== Shared (set on every backend service) =====
JWT_SECRET=                 # 40+ random chars
ANON_KEY=                   # JWT signed with JWT_SECRET, role=anon
SERVICE_ROLE_KEY=           # JWT signed with JWT_SECRET, role=service_role
PUBLIC_API_URL=https://<gateway>.up.railway.app
SITE_URL=https://<frontend>.up.railway.app

# ===== db (image: supabase/postgres:15.8.1.060) =====
POSTGRES_PASSWORD=

# ===== auth (image: supabase/gotrue:v2.170.0) =====
GOTRUE_API_HOST=0.0.0.0
PORT=9999
API_EXTERNAL_URL=${PUBLIC_API_URL}
GOTRUE_DB_DRIVER=postgres
GOTRUE_DB_DATABASE_URL=postgres://supabase_auth_admin:${POSTGRES_PASSWORD}@db.railway.internal:5432/postgres
GOTRUE_SITE_URL=${SITE_URL}
GOTRUE_URI_ALLOW_LIST=${SITE_URL}/**
GOTRUE_JWT_SECRET=${JWT_SECRET}
GOTRUE_JWT_EXP=3600
GOTRUE_JWT_DEFAULT_GROUP_NAME=authenticated
GOTRUE_JWT_ADMIN_ROLES=service_role
GOTRUE_JWT_AUD=authenticated
GOTRUE_EXTERNAL_EMAIL_ENABLED=true
GOTRUE_MAILER_AUTOCONFIRM=false
GOTRUE_SMTP_HOST=smtp.resend.com
GOTRUE_SMTP_PORT=465
GOTRUE_SMTP_USER=resend
GOTRUE_SMTP_PASS=${RESEND_API_KEY}
GOTRUE_SMTP_ADMIN_EMAIL=noreply@gyandootnova.in
GOTRUE_EXTERNAL_GOOGLE_ENABLED=true
GOTRUE_EXTERNAL_GOOGLE_CLIENT_ID=
GOTRUE_EXTERNAL_GOOGLE_SECRET=
GOTRUE_EXTERNAL_GOOGLE_REDIRECT_URI=${PUBLIC_API_URL}/auth/v1/callback

# ===== rest (image: postgrest/postgrest:v12.2.8) =====
PGRST_DB_URI=postgres://authenticator:${POSTGRES_PASSWORD}@db.railway.internal:5432/postgres
PGRST_DB_SCHEMAS=public,storage,graphql_public
PGRST_DB_ANON_ROLE=anon
PGRST_JWT_SECRET=${JWT_SECRET}
PGRST_SERVER_PORT=3000

# ===== storage (image: supabase/storage-api:v1.19.3) =====
ANON_KEY=${ANON_KEY}
SERVICE_KEY=${SERVICE_ROLE_KEY}
POSTGREST_URL=http://rest.railway.internal:3000
PGRST_JWT_SECRET=${JWT_SECRET}
DATABASE_URL=postgres://supabase_storage_admin:${POSTGRES_PASSWORD}@db.railway.internal:5432/postgres
FILE_SIZE_LIMIT=104857600
STORAGE_BACKEND=file
FILE_STORAGE_BACKEND_PATH=/var/lib/storage   # attach a Railway volume here
TENANT_ID=stub
REGION=local
GLOBAL_S3_BUCKET=stub
SERVER_PORT=5000

# ===== functions (deploy/backend/functions/Dockerfile) =====
SUPABASE_URL=${PUBLIC_API_URL}
SUPABASE_ANON_KEY=${ANON_KEY}
SUPABASE_SERVICE_ROLE_KEY=${SERVICE_ROLE_KEY}
SUPABASE_DB_URL=postgres://postgres:${POSTGRES_PASSWORD}@db.railway.internal:5432/postgres
# copy the same values you use today:
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENV=live
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RESEND_API_KEY=
OPENROUTER_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=
EXA_API_KEY=
TAVILY_API_KEY=
SERPAPI_API_KEY=
AI_PROVIDER_ENC_KEY=
SEO_CRON_TOKEN=
SEO_AGENT_CRON_SECRET=
MYSQL_DATABASE=
MYSQL_USER=
MYSQL_PASSWORD=

# ===== gateway (deploy/backend/gateway/Dockerfile) =====
AUTH_URL=http://auth.railway.internal:9999
REST_URL=http://rest.railway.internal:3000
STORAGE_URL=http://storage.railway.internal:5000
FUNCTIONS_URL=http://functions.railway.internal:9000

# ===== migrate (deploy/backend/migrate/Dockerfile) =====
DATABASE_URL=postgres://postgres:${POSTGRES_PASSWORD}@db.railway.internal:5432/postgres

# ===== frontend (root Dockerfile) =====
VITE_SUPABASE_URL=${PUBLIC_API_URL}
VITE_SUPABASE_PUBLISHABLE_KEY=${ANON_KEY}
VITE_SUPABASE_PROJECT_ID=railway
